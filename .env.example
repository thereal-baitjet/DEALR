# Supabase project. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase transaction pooler connection string from your project Connect dialog.
DATABASE_URL=
# Direct or session-pooler connection used only for migrations. Defaults to DATABASE_URL.
MIGRATION_DATABASE_URL=
# Comma-separated, verified Supabase user UUIDs. Never inferred from signup input.
DEALR_ADMIN_IDS=
# Optional OpenAI-compatible endpoint, server only. AI falls back to deterministic rules.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=text-embedding-3-small
# Approved custom application origin for email redirects and mutations.
# Leave blank on Vercel to use its exact generated deployment/branch domains.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Opt-in fictional demo workspaces. Never enable implicitly in production.
DEALR_DEMO_MODE=false
# At least 32 random characters; required for demo mode with npm start.
DEALR_DEMO_SECRET=
# Local demo only: persisted PostgreSQL files. Ignored by Git.
DEALR_DATA_DIR=.data
