# Supabase project. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase transaction pooler connection string from your project Connect dialog.
DATABASE_URL=
# Comma-separated, verified Supabase user UUIDs. Never inferred from signup input.
DEALR_ADMIN_IDS=
# Optional OpenAI-compatible endpoint, server only. AI falls back to deterministic rules.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=text-embedding-3-small
# Approved application origin for email redirects and absolute URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
